---
import PageLayout from "../layouts/Page.astro";
---

<style>
	.welcome-box {
		max-width: 900px;
		padding: 0.7em;
	}

	.welcome-text { 
		min-width: 300px; 
		width: 100%;
		font-weight: bold;
	}

	.welcome-image { 
		width: 500px;
	}

	p {
		width: 700px;
	}
</style>
<PageLayout> 
	<div class="centered-flex">
		<div class=" black-bordered-rounded welcome-box">
			<p class="centered accent-text welcome-text">
				Welcome to the official site of Sacramento's Food Not Bombs Distro!
			</p>
		</div>
	</div>
	 
	<br/>

	<div class="centered">
		<img class="welcome-image" src="./src/components/sacfnb_no_outline.png"/>
		<br/>
		<br/>
		<h3>Who are we?</h3>
		<div class="centered" style="display: flex;">
		<p class="">
			We are a sect based in Sacramento, California for a non-profit mutual aid organization known as Food Not Bombs. We believe all people are equal and that no one should be left thirsty, starving, cold, or without medical help when we have far more than enough resources to take care of everyone in need; we are all in this together, and the world only gets better by helping each other out in any way we can from a place of genuine compassion and love for our unmet friends. We stand by our beliefs in our mutual aid work by handing out food, water, first aid supplies, toiletries, blankets, clothes, and more to our local community free of charge. Through our collective action, we wish to help create a better world for all.
		</p>
		</div>
	</div>
</PageLayout>
