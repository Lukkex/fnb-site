---
import SiteLogo from "./logos/SiteLogo.astro";

const today = new Date();
---

<footer>

	<body>
		<main>
		</main>
	</body>

	&copy; {today.getFullYear()} Food Not Bombs of Sacramento, All rights reserved.
	<br>
	<div class="social-links">
		<a target="_blank" href="">
			<span class="sr-only">Follow our Instagram page</span>
			<SiteLogo/>
		</a>
	</div>
</footer>
<style>
	a {
  		text-decoration: none !important;
	}

	footer {
		padding: 2em 1em 6em 1em;
		text-align: center;
		z-index: 2;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em; 
	}

	.social-links a {
		text-decoration: none;
		color: rgb(var(--white));
	}

	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}


	@media (max-width: 768px){
		.comments {
			width: 100%;
		}
	}
</style>
