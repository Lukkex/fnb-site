---
import Image from "astro:assets";
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import SiteLogo from "./logos/SiteLogo.astro";
---

<header class="stick">
	<nav>
		<!-- LEFT SECTION -->
		<div class="left">
			<h2><a href="/"><SiteLogo/></a></h2>
		</div>

		<!-- CENTER SECTION -->
		<div class="middle desktop">
			<div class="centered">
				<h2>Sacramento Food Not Bombs</h2>
			</div>	
		</div>

		<!-- RIGHT SECTION -->
		<div class="right internal-links desktop">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/join">Join</HeaderLink>
			<HeaderLink href="/donate">Donate</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>

		<!-- MOBILE DROPDOWN MENU -->
		<div class="mobile">
			<div class="right internal-links dropdown">
				<button class="dropbtn">Menu</button>
				<div class="dropdown-content">
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href="/join">Join</HeaderLink>
					<HeaderLink href="/donate">Donate</HeaderLink>
					<HeaderLink href="/about">About</HeaderLink>
				</div>
			</div>
		</div>
	</nav>
</header>
<style>

	h1, h2 {
		font-size: 2.5vw;
		color: white; 
  		text-shadow: -5px 5px 0 #000, 1px -1px 0 #000, -1px 5px 0 #000, 1px 5px 0 #000;
	}

	a {
		font-size: 2vw; 
	}

	.internal-links {
		display: flex;
		column-gap: 20px;
		margin: 10;
		background: black;
		border: 1px solid rgba(255, 255, 255, 0.137);
		border-top-left-radius: 1vw;
		border-top-right-radius: 1vw;
		border-bottom-left-radius: 1vw;
		border-bottom-right-radius: 1vw;
		box-shadow: 10px 10px 20px rgba(var(--black), 100%);
		z-index: 20;
	}

	.internal-links a {
		color: white; 
		text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
	}

	.mobile-logo {
		display: none;
	}

	.mobile{
		display: none;
	} 

	.desktop{ 
	}

	.left {
		flex: 1;
		display: flex;
		align-items: left;
		justify-content: left;
        padding-top: 1vh;
        padding-left: 1vw;
	}

	.middle {
		flex: 2;
		align-items: center;
		justify-content: center;
	}

	.right {
		flex: 1;
		display: flex;
		align-items: right;
		justify-content: right;
        padding-top: 1vh;
        padding-right: 1vw;
	}

	header {
		margin: 0;
		padding: 0 1em;
		background-image: url("./trans-bg5.png"); 
		background-size: 4vw;
		background-position: center;
		border: 1px solid rgba(255, 255, 255, 0.137);
		border-bottom-left-radius: 3vw;
		border-bottom-right-radius: 3vw;
		box-shadow: 10px 10px 20px rgba(var(--black), 100%);
		z-index: 20;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a:hover {
		text-shadow: 0 0 10px rgba(255, 0, 138, 1), 0 0 20px rgba(255, 0, 138, 1), 0 0 30px rgba(255, 0, 138, 1);
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		animation: glowing 2s linear infinite;
	}

	/* Styles for phones */
	@media only screen and (max-width: 685px) {
		.mobile-logo {
			display:flex;
			padding-top: 45px;
			width: auto;
			height: 9vh;
		}

		.desktop {
			display: none;
		}

		.mobile {
			display: contents;
		}

		.dropbtn {
			display: contents;
			text-align: center;
		}

		.dropdown {
			display: contents;
		}

		a {
			font-size: 4vw;
			font-weight: bold;
		}

		/** DROPDOWN MENU **/
		/* Dropdown Button */
		.dropbtn {
		background-color: #ffffff;
		color: white;
		padding: 16px;
		font-size: 16px;
		border: none;
		}

		/* The container <div> - needed to position the dropdown content */
		.dropdown {
		position: relative;
		display: inline-block;
		}

		/* Dropdown Content (Hidden by Default) */
		.dropdown-content {
		display: none;
		position: absolute;
		background-color: #f1f1f1;
		min-width: 160px;
		box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
		z-index: 1;
		}

		/* Links inside the dropdown */
		.dropdown-content a {
		color: black;
		padding: 12px 16px;
		text-decoration: none;
		display: block;
		}

		/* Change color of dropdown links on hover */
		.dropdown-content a:hover {background-color: #ddd;}

		/* Show the dropdown menu on hover */
		.dropdown:hover .dropdown-content {display: block;}

		/* Change the background color of the dropdown button when the dropdown content is shown */
		.dropdown:hover .dropbtn {background-color: #3e8e41;} 

		/** END OF DROPDOWN MENU **/
	}

</style>
