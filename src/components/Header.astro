---
import Image from "astro:assets";
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import SiteLogo from "./logos/SiteLogo.astro";
---

<header class="stick">
	<nav>
		<!-- LEFT SECTION -->
		<div class="">
			<a class="icon" href=`${import.meta.env.BASE_URL}/`><SiteLogo/></a>
		</div>

		<!-- MIDDLE SECTION -->
		<div class="desktop middle">
			<h1 class="subtitle accent-text">SACRAMENTO</h1>
			<h1 class="title accent-text">FOOD NOT BOMBS</h1>
		</div>
		
		<div class="mobile">
			<div class="mobile-middle">
				<h1 class="mobile-title">FOOD NOT BOMBS</h1>
				<h1 class="mobile-subtitle">SACRAMENTO</h1>
			</div>
		</div>

		<!-- RIGHT SECTION -->
		<div class="right internal-links desktop">
			<div>
				<HeaderLink href=`${import.meta.env.BASE_URL}/`>Home</HeaderLink>
			</div>
			<div>
				<HeaderLink href=`${import.meta.env.BASE_URL}/faqs#join`>Join</HeaderLink>
			</div>
			<div>
				<HeaderLink href=`${import.meta.env.BASE_URL}/donate`>Donate</HeaderLink>
			</div>
			<div class="dropdown">
				<HeaderLink class="dropbtn" href=`${import.meta.env.BASE_URL}/about`>About</HeaderLink>
				<div class="dropdown-content">
					<HeaderLink href=`${import.meta.env.BASE_URL}/`>Home</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/faqs#join`>Join</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/donate`>Donate</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/about`>About</HeaderLink>
				</div>
			</div>
		</div>

		<div class="mobile">
			<div class="dropdown">
				<button class="dropbtn">III</button>
				<div class="dropdown-content">
					<HeaderLink href=`${import.meta.env.BASE_URL}/`>Home</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/faqs#join`>Join</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/donate`>Donate</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/about`>About</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/faqs`>FAQs</HeaderLink>
					<HeaderLink href=`${import.meta.env.BASE_URL}/resources`>Resources</HeaderLink>
				</div>
			</div>
		</div>
	</nav>

	<hr class="pride-bar desktop middle" >
	
</header>
<style>
	h1 {
		font-size: 2.7vw;
		color: white; 
		-webkit-text-stroke: 0.1vw #000;
	}

	.title {
		text-align: left;
		font-size: 4vw;
		transform: translateY(-15%);
		padding-left: 5%;
		
		color: var(--accent-text);
		font-weight: bolder;
		font-family: 'Hussar", serif';
		letter-spacing: 0em;
	}

	.subtitle {
		text-align: left;
		padding-left: 10%;
		transform: translateY(30%);
	}

	a {
		font-size: 2vw; 
	}

	.icon {
		font-size: 3vw;
		padding: 0;
	}

	.internal-links * {
		text-decoration: none; 
		column-gap: 20px;
		margin: 10; 
		color: white;  
	}

	.mobile{
		display: none;
	} 

	.left {
		flex: 1;
		display: flex;
		align-items: left;
		justify-content: left;
	}

	.middle {
		flex: 10;
		justify-content: left;
	}

	.right {
		flex: 7;
		display: flex; 
		justify-content: right;
	}

	header {
		margin: 0;
		padding: 0 1em;
		background-color: #1E1E1E;
		background-position: center;

		border-bottom-left-radius: 0.5vw;
		border-bottom-right-radius: 0.5vw;
		box-shadow: 10px 10px 20px rgba(var(--black), 70%);
		z-index: 20;
	}

	.pride-bar {
		transform: translateY(-20);
		position: relative;
		border: none;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		height: 30px;
		background: repeating-linear-gradient(to right, 
											#FFFFFF, #FFFFFF 30px, 
											#F7BCC2 30px, #F7BCC2 60px, 
											#74C4F5 60px, #74C4F5 90px);
	}

	/* second pass overlay to darken the pride bar - sense of depth */
	.pride-bar::after {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(to bottom, 
									rgba(5, 5, 5, 0.5) 10% , rgba(5, 5, 5, 0.5) 25%, 		/* top darkening */
									rgba(0,0,0,0) 25%, rgba(0, 0, 0, 0) 85%, 				/* clear center */
									rgba(5, 5, 5, 0.5) 85%, rgba(5, 5, 5, 0.5) 100%);		/* bottom darkening */
	}

	p {
		text-align: center;
	}

	nav {
		display: flex; 
		align-items: center;
		justify-content: space-between;
	}

	nav a:hover {
		text-shadow: 0 0 10px var(--accent), 0 0 20px var(--accent), 0 0 30px var(--accent);
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		animation: glowing 2s linear infinite;
	}

	/** DROPDOWN MENU **/
	/* Dropdown Button */
	.dropbtn {   
	}

	/* The container <div> - needed to position the dropdown content */
	.dropdown {
		position: relative;
		display: inline-block;
		direction: rtl;
	}

	/* Dropdown Content (Hidden by Default) */
	.dropdown-content {
		transform: translate(25px, -15px);
		direction: rtl;
		display: none;
		position: absolute; 
		min-width: 160px;

		background-color: #f1f1f1;
		box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
		z-index: 1;
	}

	/* Links inside the dropdown */
	.dropdown-content a {
		color: black;
		padding: 12px 16px;
		background-color: #f1f1f1;
		text-decoration: none; 
		display: none;
	}

	/* Change color of dropdown links on hover */
	.dropdown-content a:hover {
		background-color: #ddd;
	}
	
	.dropbtn:hover .dropdown-content, .dropbtn:hover .dropdown-content a {
		display: block;
	}

	/* Show the dropdown menu on hover */
	.dropdown:hover .dropdown-content, .dropdown:hover .dropdown-content a {
		display: block;
	}

	/* Change the background color of the dropdown button when the dropdown content is shown */
	.dropdown:hover .dropbtn { 
	} 

	/** END OF DROPDOWN MENU **/



	/* Mobile Styles */
	@media only screen and (max-width: 685px) {

		.icon {
			font-size: 4.5vw;
		}

		h1, h2 {
			font-size: 0.9em;
			font-weight: bolder;
			-webkit-text-stroke: 0.5px #000;	
		}

		.mobile-middle {
			flex: 10;
		}

		.mobile-title {
			text-align: left;
			font-size: 6vw;
			transform: translateY(80%);
			padding-left: 5%;
			
			color: var(--accent-text);
			font-weight: bolder;
			font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
			letter-spacing: -0.1em;
		}

		.mobile-subtitle {
			text-align: left;
			padding-left: 10%;
			font-size: 4vw;
			transform: translateY(-130%);

			font-weight: bolder;
			font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
			letter-spacing: -0.1em;
		}

		header {
			margin: 0.3em;
			margin-top: 0.5em;
			border-radius: 10vw;
			height: 64px;
		}

		.mobile-logo {
			display:flex;
			padding-top: 45px;
			width: auto;
			height: 9vh;
		}

		.desktop {
			display: none;
		}

		.mobile {
			display: contents;
		}

		a {
			font-size: 4vw;
			font-weight: bold;
		}

		/** DROPDOWN MENU **/
		/* Dropdown Button */
		.dropbtn {
			background-color: #1E1E1E;
			color: white;
			font-size: 30px;
			font-weight: bold;
			font-family: 'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;
			border: none;
			rotate: 90deg;

			/* gradient for hamburger */
			background: linear-gradient(to left, #dd90ad 40%, #ffffff 40%, #ffffff 60%, #4db7ec 60%);
			-webkit-background-clip: text;
			background-clip: text;
			-webkit-text-fill-color: transparent;
		}

		/* The container <div> - needed to position the dropdown content */
		.dropdown {
			position: relative;
			display: inline;
		}

		/* Dropdown Content (Hidden by Default) */
		.dropdown-content {
			transform: translateX(70px);
			display: none;
			position: absolute;
			background-color: #f1f1f1;
			min-width: 160px;
			box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
			z-index: 1;
		}

		/* Links inside the dropdown */
		.dropdown-content a {
			color: black;
			padding: 12px 16px;
			text-decoration: none;
			display: block;
		}

		/* Change color of dropdown links on hover */
		.dropdown-content a:hover {
			background-color: #ddd;
		}

		/* Show the dropdown menu on hover */
		.dropdown:hover .dropdown-content {
			display: block;
		}

		/* Change the background color of the dropdown button when the dropdown content is shown */
		.dropdown:hover .dropbtn {
			background-color: #575757;
		} 

		/** END OF DROPDOWN MENU **/
	}

</style>
