---
import Image from "astro:assets";
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import SiteLogo from "./logos/SiteLogo.astro";
---

<header class="stick">
	<div class="mobile-logo centering-container">
		<a href="/"><img src={""} width="230"/></a>
	</div>
	<nav>
		<!-- LEFT SECTION -->
		<div class = "left">
			<h2><a href="/"><SiteLogo/></a></h2>
		</div>

		<!-- CENTER SECTION -->
		<div class="middle">
			<div class="centered">
				<h1>Food Not Bombs</h1>
			</div>	
			<div class="centered">
				<h2>Sacramento</h2>
			</div>
		</div>

		<!-- RIGHT SECTION -->
		<div class = "desktop">
			<div class = "right">
				<div class="internal-links">
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href="/join">Join</HeaderLink>
					<HeaderLink href="/donate">Donate</HeaderLink>
					<HeaderLink href="/about">About</HeaderLink>
				</div>
			</div>
		</div>
	</nav>
</header>
<style>
	.internal-links {
		display: flex;
		column-gap: 20px;
	}

	.mobile-logo {
		display: none;
	}

	.mobile{
		display: none;
	}

	.desktop{
		display: contents;
	}

	.left {
		flex: 1;
		display: flex;
		align-items: left;
		justify-content: left;
        padding-top: 1vh;
        padding-left: 1vw;
	}

	.middle {
		flex: 1;
		align-items: center;
		justify-content: center;
	}

	.right {
		flex: 1;
		display: flex;
		align-items: right;
		justify-content: right;
        padding-top: 1vh;
        padding-right: 1vw;
	}

	header {
		margin: 0;
		padding: 0 1em;
		background-image: linear-gradient(var(--theme-gradient));
		border: 1px solid rgba(255, 255, 255, 0.137);
		border-bottom-left-radius: 3vw;
		border-bottom-right-radius: 3vw;
		box-shadow: 10px 10px 20px rgba(var(--black), 100%);
		z-index: 20;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	nav a:hover {
		text-shadow: 0 0 10px rgba(255, 0, 138, 1), 0 0 20px rgba(255, 0, 138, 1), 0 0 30px rgba(255, 0, 138, 1);
	}

	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
		animation: glowing 2s linear infinite;
	}

	/* Styles for phones */
	@media only screen and (max-width: 685px) {
		.mobile-logo {
			display:flex;
			padding-top: 45px;
			width: auto;
			height: 9vh;
		}

		.desktop {
			display: none;
		}

		.mobile {
			display: contents;
		}
	}

</style>
